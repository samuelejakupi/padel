# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# Lo riscrive scripts/write-version.mjs prima di ogni build, con un numero
# diverso ogni volta. Seguito da git darebbe un conflitto a ogni push fatto
# da due persone diverse, e non servirebbe a niente: in produzione lo genera
# la build di Vercel.
/public/version.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.npm-cache/
.dev-*.log

# typescript incremental build info
*.tsbuildinfo
